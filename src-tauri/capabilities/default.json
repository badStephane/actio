{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions minimales de la fenêtre principale",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "sql:allow-load",
      "allow": [{ "database": "sqlite:inscriptions.db" }]
    },
    {
      "identifier": "sql:allow-execute",
      "allow": [{ "database": "sqlite:inscriptions.db" }]
    },
    {
      "identifier": "sql:allow-select",
      "allow": [{ "database": "sqlite:inscriptions.db" }]
    },
    "updater:default",
    "process:default",
    "allow-export-database",
    "allow-restore-database",
    "allow-reset-app-data",
    "allow-list-auto-backups"
  ]
}
